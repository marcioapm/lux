# Spike only (.spike/lxcfs.md): one workload image with every tool the
# probes read sizes with, and both nested engines (Podman as in
# tests/images/nested, rootless Docker as in tests/images/docker).
FROM docker.io/library/alpine:3.24.2
RUN apk add --no-cache podman fuse-overlayfs shadow-uidmap libcap-setcap \
      docker docker-rootless-extras slirp4netns iptables ip6tables \
      procps coreutils util-linux python3 nodejs \
 && setcap cap_setuid=ep /usr/bin/newuidmap && setcap cap_setgid=ep /usr/bin/newgidmap \
 && ln -f /usr/bin/passt /usr/bin/pasta \
 && if [ -e /usr/bin/passt.avx2 ]; then ln -f /usr/bin/passt.avx2 /usr/bin/pasta.avx2; fi \
 && adduser -D -u 1000 agent \
 && printf 'agent:1:999\nagent:1001:64535\n' > /etc/subuid && cp /etc/subuid /etc/subgid \
 && mkdir -p /home/agent/.config/containers \
 && printf '[storage]\ndriver = "overlay"\n[storage.options.overlay]\nmount_program = "/usr/bin/fuse-overlayfs"\n' > /home/agent/.config/containers/storage.conf \
 && chown -R agent:agent /home/agent
COPY --chmod=644 alpine.tar /opt/alpine.tar
COPY --chmod=755 probe.sh /opt/probe.sh
USER agent
WORKDIR /home/agent
