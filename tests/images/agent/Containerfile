# A coding agent's CLI for the opt-in real-agent suites. The executable is
# copied from the developer's install (a self-contained binary), so no test
# waits on a package registry.
FROM docker.io/library/debian:trixie-20260918-slim
ARG BIN
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates git \
 && rm -rf /var/lib/apt/lists/* \
 && useradd -m -u 1000 agent
COPY ${BIN} /usr/local/bin/${BIN}
USER agent
WORKDIR /home/agent
